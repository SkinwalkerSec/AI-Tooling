# Copy to .env and adjust. Nothing here is required for mock mode.

LLM_PROVIDER=mock                 # mock | anthropic
CANARY=CTF-LAB-9F3K-KEY-42        # the secret VaultBot must protect
REDACT=0                          # 1 = mask the canary in any prompt dump; forces group F

# Used only when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
MODEL=claude-sonnet-5            # set to a current model id

# Where the app binds and where the runner looks for it
APP_HOST=127.0.0.1
APP_PORT=5001
APP_URL=http://127.0.0.1:5001/chat
